+  @Test
+  public void testPushBlob_commitRetryRejectedButBlobCommitted()
+      throws IOException, RegistryException {
+    List<String> requests = Collections.synchronizedList(new ArrayList<>());
+    HttpServer server = startSlowCommitRegistry(true, requests);
+    System.setProperty(JibSystemProperties.HTTP_TIMEOUT, "300");
+    try {
+      RegistryClient registryClient =
+          RegistryClient.factory(
+                  eventHandlers,
+                  "localhost:" + server.getAddress().getPort(),
+                  "foo/bar",
+                  new PlainHttpClient())
+              .newRegistryClient();
+
+      Assert.assertFalse(registryClient.pushBlob(digest, Blobs.from("hello"), null, ignored -> {}));
+      Assert.assertEquals("HEAD /v2/foo/bar/blobs/" + digest, requests.get(requests.size() - 1));
+    } finally {
+      System.clearProperty(JibSystemProperties.HTTP_TIMEOUT);
+      server.stop(0);
+    }
+  }
+
+  @Test
+  public void testPushBlob_commitRetryRejectedAndBlobMissing()
+      throws IOException, RegistryException {
+    List<String> requests = Collections.synchronizedList(new ArrayList<>());
+    HttpServer server = startSlowCommitRegistry(false, requests);
+    System.setProperty(JibSystemProperties.HTTP_TIMEOUT, "300");
+    try {
+      RegistryClient registryClient =
+          RegistryClient.factory(
+                  eventHandlers,
+                  "localhost:" + server.getAddress().getPort(),
+                  "foo/bar",
+                  new PlainHttpClient())
+              .newRegistryClient();
+
+      try {
+        registryClient.pushBlob(digest, Blobs.from("hello"), null, ignored -> {});
+        Assert.fail();
+      } catch (RegistryErrorException ex) {
+        MatcherAssert.assertThat(
+            ex.getMessage(), CoreMatchers.containsString("blob upload unknown to registry"));
+      }
+    } finally {
+      System.clearProperty(JibSystemProperties.HTTP_TIMEOUT);
+      server.stop(0);
+    }
+  }
+
+  /**
+   * Mimics ghcr.io committing a large BLOB: the first commit {@code PUT} outlasts the client read
+   * timeout (the BLOB is committed anyway), so the retried {@code PUT} hits a consumed upload
+   * session and gets 404 {@code BLOB_UPLOAD_UNKNOWN}.
+   */
+  private static HttpServer startSlowCommitRegistry(boolean blobCommitted, List<String> requests)
+      throws IOException {
+    AtomicInteger commits = new AtomicInteger();
+    HttpServer server = HttpServer.create(new InetSocketAddress(0), 0);
+    server.setExecutor(Executors.newCachedThreadPool());
+    server
+        .createContext("/")
+        .setHandler(
+            exchange -> {
+              String method = exchange.getRequestMethod();
+              requests.add(method + " " + exchange.getRequestURI().getPath());
+              ByteStreams.exhaust(exchange.getRequestBody());
+              switch (method) {
+                case "POST":
+                case "PATCH":
+                  exchange.getResponseHeaders().set("Location", "/upload");
+                  exchange.sendResponseHeaders(202, -1);
+                  break;
+                case "PUT":
+                  if (commits.getAndIncrement() == 0) {
+                    Uninterruptibles.sleepUninterruptibly(1, TimeUnit.SECONDS);
+                    exchange.sendResponseHeaders(201, -1);
+                  } else {
+                    byte[] body =
+                        ("{\"errors\":[{\"code\":\"BLOB_UPLOAD_UNKNOWN\","
+                                + "\"message\":\"blob upload unknown to registry\"}]}")
+                            .getBytes(StandardCharsets.UTF_8);
+                    exchange.sendResponseHeaders(404, body.length);
+                    exchange.getResponseBody().write(body);
+                  }
+                  break;
+                case "HEAD":
+                  if (blobCommitted) {
+                    exchange.getResponseHeaders().set("Content-Length", "5");
+                    exchange.sendResponseHeaders(200, -1);
+                  } else {
+                    exchange.sendResponseHeaders(404, -1);
+                  }
+                  break;
+                default:
+                  exchange.sendResponseHeaders(500, -1);
+              }
+              exchange.close();
+            });
+    server.start();
+    return server;
+  }
+
