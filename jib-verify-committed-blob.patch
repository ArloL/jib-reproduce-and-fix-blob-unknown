+  /**
+   * Starts a registry that accepts BLOB uploads. It answers commits ({@code PUT}) and BLOB checks
+   * ({@code HEAD}) in order from the given lists, and with 500 once a list runs out. A commit
+   * response is either "201" or an error code; {@code BLOB_UNKNOWN} and {@code BLOB_UPLOAD_UNKNOWN}
+   * are sent with 404, like ghcr.io does when a commit is retried after a read timeout, and other
+   * codes with 400.
+   *
+   * @return the requests received, as the method (and the path for {@code HEAD})
+   */
+  private List<String> startUploadRegistry(
+      List<String> commitResponses, List<Integer> blobCheckStatuses) throws IOException {
+    Iterator<String> commits = commitResponses.iterator();
+    Iterator<Integer> blobChecks = blobCheckStatuses.iterator();
+    List<String> requests = Collections.synchronizedList(new ArrayList<>());
+    uploadRegistry = HttpServer.create(new InetSocketAddress(0), 0);
+    uploadRegistry
+        .createContext("/")
+        .setHandler(
+            exchange -> {
+              String method = exchange.getRequestMethod();
+              requests.add(
+                  "HEAD".equals(method)
+                      ? method + " " + exchange.getRequestURI().getPath()
+                      : method);
+              ByteStreams.exhaust(exchange.getRequestBody());
+              switch (method) {
+                case "POST":
+                case "PATCH":
+                  exchange.getResponseHeaders().set("Location", "/upload");
+                  exchange.sendResponseHeaders(202, -1);
+                  break;
+                case "PUT":
+                  String commit = commits.hasNext() ? commits.next() : "500";
+                  if ("201".equals(commit) || "500".equals(commit)) {
+                    exchange.sendResponseHeaders(Integer.parseInt(commit), -1);
+                    break;
+                  }
+                  // e.g. BLOB_UPLOAD_UNKNOWN -> "blob upload unknown to registry"
+                  String message = commit.toLowerCase(Locale.ROOT).replace('_', ' ');
+                  byte[] error =
+                      String.format(
+                              "{\"errors\":[{\"code\":\"%s\",\"message\":\"%s to registry\"}]}",
+                              commit, message)
+                          .getBytes(StandardCharsets.UTF_8);
+                  exchange.sendResponseHeaders(
+                      commit.endsWith("_UNKNOWN") ? 404 : 400, error.length);
+                  exchange.getResponseBody().write(error);
+                  break;
+                case "HEAD":
+                  exchange.getResponseHeaders().set("Content-Length", "5");
+                  exchange.sendResponseHeaders(blobChecks.hasNext() ? blobChecks.next() : 500, -1);
+                  break;
+                default:
+                  exchange.sendResponseHeaders(405, -1);
+              }
+              exchange.close();
+            });
+    uploadRegistry.start();
+    return requests;
+  }
+
+  private boolean pushBlob(Blob blob) throws IOException, RegistryException {
+    return RegistryClient.factory(
+            eventHandlers,
+            "localhost:" + uploadRegistry.getAddress().getPort(),
+            "foo/bar",
+            new PlainHttpClient())
+        .newRegistryClient()
+        .pushBlob(digest, blob, null, ignored -> {});
+  }
