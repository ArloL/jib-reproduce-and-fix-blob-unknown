From edceff1da79028fb30b5ad244a4f91358a22af1a Mon Sep 17 00:00:00 2001
From: Arlo O'Keeffe <tiger@k5d.de>
Date: Fri, 18 Sep 2026 17:10:40 +0200
Subject: [PATCH] fix: verify BLOB exists when commit fails after a timed-out
 retry

When a registry (e.g., ghcr.io) commits a large BLOB slower than the
read timeout, the finalize PUT is retried against an already-consumed
upload session and fails with BLOB_UNKNOWN / BLOB_UPLOAD_UNKNOWN even
though the BLOB was committed. Check the BLOB with HEAD before failing.

Fixes #4301
---
 .../tools/jib/registry/RegistryClient.java    |  14 ++-
 .../jib/registry/RegistryClientTest.java      | 114 ++++++++++++++++++
 2 files changed, 127 insertions(+), 1 deletion(-)

diff --git a/jib-core/src/main/java/com/google/cloud/tools/jib/registry/RegistryClient.java b/jib-core/src/main/java/com/google/cloud/tools/jib/registry/RegistryClient.java
index a2d97e35..a3f85c86 100644
--- a/jib-core/src/main/java/com/google/cloud/tools/jib/registry/RegistryClient.java
+++ b/jib-core/src/main/java/com/google/cloud/tools/jib/registry/RegistryClient.java
@@ -561,7 +561,19 @@ public class RegistryClient {
         timerEventDispatcher2.lap("pushBlob PUT " + blobDigest);
 
         // PUT <Location>?digest={blob.digest}
-        callRegistryEndpoint(blobPusher.committer(putLocation));
+        try {
+          callRegistryEndpoint(blobPusher.committer(putLocation));
+        } catch (RegistryErrorException ex) {
+          // A commit that outlasts the read timeout may still succeed; the retried PUT then fails
+          // (e.g., BLOB_UPLOAD_UNKNOWN) because the upload session is consumed.
+          // https://github.com/GoogleContainerTools/jib/issues/4301
+          if (!checkBlob(blobDigest).isPresent()) {
+            throw ex;
+          }
+          eventHandlers.dispatch(
+              LogEvent.debug(
+                  "Commit of BLOB " + blobDigest + " failed but the BLOB exists; ignoring: " + ex));
+        }
 
         return false;
       }
diff --git a/jib-core/src/test/java/com/google/cloud/tools/jib/registry/RegistryClientTest.java b/jib-core/src/test/java/com/google/cloud/tools/jib/registry/RegistryClientTest.java
index 97f72cda..064d36b1 100644
--- a/jib-core/src/test/java/com/google/cloud/tools/jib/registry/RegistryClientTest.java
+++ b/jib-core/src/test/java/com/google/cloud/tools/jib/registry/RegistryClientTest.java
@@ -22,12 +22,19 @@ import com.google.cloud.tools.jib.api.LogEvent;
 import com.google.cloud.tools.jib.api.RegistryException;
 import com.google.cloud.tools.jib.api.RegistryUnauthorizedException;
