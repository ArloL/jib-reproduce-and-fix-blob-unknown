-        // POST /v2/<name>/blobs/uploads/
-        Optional<URL> patchLocation = callRegistryEndpoint(blobPusher.initializer());
-        if (!patchLocation.isPresent()) {
-          // The BLOB exists already.
-          return true;
-        }
-
-        timerEventDispatcher2.lap("pushBlob PATCH " + blobDigest);
+      for (int attempt = 1; ; attempt++) {
+        try (TimerEventDispatcher timerEventDispatcher2 =
+            timerEventDispatcher.subTimer("pushBlob POST " + blobDigest)) {
+
+          // POST /v2/<name>/blobs/uploads/?mount={blob.digest}&from={sourceRepository}
+          // POST /v2/<name>/blobs/uploads/
+          Optional<URL> patchLocation = callRegistryEndpoint(blobPusher.initializer());
+          if (!patchLocation.isPresent()) {
+            // The BLOB exists already.
+            return true;
+          }
 
-        // PATCH <Location> with BLOB
-        URL putLocation =
-            callRegistryEndpoint(blobPusher.writer(patchLocation.get(), writtenByteCountListener));
+          timerEventDispatcher2.lap("pushBlob PATCH " + blobDigest);
 
-        timerEventDispatcher2.lap("pushBlob PUT " + blobDigest);
+          // PATCH <Location> with BLOB
+          URL putLocation =
+              callRegistryEndpoint(
+                  blobPusher.writer(patchLocation.get(), writtenByteCountListener));
 
-        // PUT <Location>?digest={blob.digest}
-        callRegistryEndpoint(blobPusher.committer(putLocation));
+          timerEventDispatcher2.lap("pushBlob PUT " + blobDigest);
 
-        return false;
+          // PUT <Location>?digest={blob.digest}
+          try {
+            callRegistryEndpoint(blobPusher.committer(putLocation));
+            return false;
+
+          } catch (RegistryErrorException ex) {
+            // A registry may reject a commit that it has completed or lost. For example, ghcr.io
+            // can take longer than the read timeout to commit a large BLOB. The retried commit
+            // then fails with BLOB_UPLOAD_UNKNOWN if the first attempt committed the BLOB, or with
+            // BLOB_UNKNOWN if the upload was lost.
+            // See https://github.com/GoogleContainerTools/jib/issues/4301
+            if (!isBlobOrUploadUnknown(ex)) {
+              throw ex;
+            }
+            if (isBlobPresent(blobDigest, ex)) {
+              eventHandlers.dispatch(
+                  LogEvent.debug(
+                      "committing BLOB " + blobDigest + " failed, but it exists; continuing"));
+              return false;
+            }
+            if (attempt == MAX_BLOB_UPLOAD_ATTEMPTS || !blob.isRetryable()) {
+              throw ex;
+            }
+            eventHandlers.dispatch(
+                LogEvent.warn("committing BLOB " + blobDigest + " failed; uploading it again"));
+          }
+        }
       }
     }
   }
 
+  private static boolean isBlobOrUploadUnknown(RegistryErrorException ex) {
+    if (!(ex.getCause() instanceof ResponseException)) {
+      return false;
+    }
+    try {
+      ErrorCodes errorCode = ErrorResponseUtil.getErrorCode((ResponseException) ex.getCause());
+      return errorCode == ErrorCodes.BLOB_UNKNOWN || errorCode == ErrorCodes.BLOB_UPLOAD_UNKNOWN;
+    } catch (ResponseException ignored) {
+      return false;
+    }
+  }
+
+  /**
+   * Checks whether a BLOB exists after committing it failed.
+   *
+   * @param blobDigest the digest of the BLOB to check
+   * @param commitException the exception from committing the BLOB
+   * @return {@code true} if the BLOB exists
+   * @throws RegistryErrorException {@code commitException}, with the reason as a suppressed
+   *     exception, if checking fails
+   */
+  private boolean isBlobPresent(DescriptorDigest blobDigest, RegistryErrorException commitException)
+      throws RegistryErrorException {
+    try {
+      return checkBlob(blobDigest).isPresent();
+    } catch (IOException | RegistryException ex) {
+      commitException.addSuppressed(ex);
+      throw commitException;
+    }
+  }
